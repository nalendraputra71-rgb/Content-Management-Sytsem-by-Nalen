rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ─── UTILS ───────────────────────────────────────────────────────────────
    function isSignedIn() { return request.auth != null; }
    
    // Pure token-based isAdmin check (avoids rules-engine document read cost)
    function isAdmin() { 
      return isSignedIn() && request.auth.token.email != null && (
        request.auth.token.email == 'nalendraputra71@gmail.com' || 
        request.auth.token.email == 'NalendraPutra71@gmail.com'
      ); 
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // RBAC Helpers
    function isMember(wsId) { 
      return isSignedIn() && exists(/databases/$(database)/documents/workspaces/$(wsId)/members/$(request.auth.uid)); 
    }
    
    function isEditor(wsId) { 
      return isSignedIn() && (
        (resource != null && resource.data.ownerId == request.auth.uid) ||
        (resource != null && resource.data.userId == request.auth.uid) ||
        (exists(/databases/$(database)/documents/workspaces/$(wsId)/members/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/workspaces/$(wsId)/members/$(request.auth.uid)).data.role in ["owner", "editor"])
      ); 
    }

    function isCommenter(wsId) {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/workspaces/$(wsId)/members/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/workspaces/$(wsId)/members/$(request.auth.uid)).data.role in ["owner", "editor", "commenter"]) ||
        (resource != null && (request.auth.uid in resource.data.get('commenterUids', []) || request.auth.uid in resource.data.get('editorUids', [])))
      );
    }
    
    function isOwner(wsId) { 
      return isSignedIn() && (
        (resource != null && resource.data.ownerId == request.auth.uid) ||
        (exists(/databases/$(database)/documents/workspaces/$(wsId)/members/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/workspaces/$(wsId)/members/$(request.auth.uid)).data.role == "owner")
      ); 
    }

    // ─── DEFAULT DENY ────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

    // ─── CONFIG & PUBLIC DATA ────────────────────────────────────────────────
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /global_notifications/{notifId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId && incoming().uid == userId;
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'nickname', 'avatar', 'username', 'activeUntil', 'plan', 'hasUsedPromo', 'emailVerified', 'createdAt', 'themeId', 'bio', 'following', 'followers', 'aiTokensUsed', 'aiRequestsCount', 'aiRequestsToday', 'lastAiRequestDate', 'completedTour', 'role'])) ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['followers'])) ||
        isAdmin()
      );
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      
      match /hubaiConfig/{document=**} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
      
      match /aiChats/{document=**} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // ─── COLLECTION GROUP RULES (EVALUATED FAST) ───────────────────────────
    match /{path=**}/members/{memberId} {
      allow read: if isSignedIn() && (
        memberId == request.auth.uid || 
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }

    match /{path=**}/content/{contentId} {
      allow read: if isSignedIn() && (
        (resource != null && resource.data.userId == request.auth.uid) ||
        (resource != null && resource.data.get('sharedUids', []) is list && request.auth.uid in resource.data.get('sharedUids', [])) ||
        (resource != null && resource.data.get('isPublic', false) == true) ||
        isAdmin()
      );
    }

    // ─── ADMINS ───────────────────────────────────────────────────────────────
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ─── PLANS & PROMOS ───────────────────────────────────────────────────────
    match /plans/{planId} {
       allow read: if true;
       allow write: if isAdmin();
    }
    match /promos/{promoId} {
       allow read: if true;
       allow write: if isAdmin();
    }

    // ─── TRANSACTIONS ─────────────────────────────────────────────────────────
    match /transactions/{txId} {
       allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
       allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
       allow update, delete: if isAdmin();
    }
    match /usernames/{username} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && (resource == null || resource.data.get('uid', request.auth.uid) == request.auth.uid);
    }

    match /tickets/{ticketId} {
       allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
       allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
       allow update: if isSignedIn() && (isAdmin() || (resource.data.userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['messages', 'updatedAt', 'status', 'readByUser'])));
       allow delete: if isAdmin();
    }

    match /accountDeletionReasons/{reasonId} {
       allow create: if isSignedIn();
       allow read, update, delete: if isAdmin();
    }

    // ─── SOC & CHATS ─────────────────────────────────────────────────────────
    match /soc_posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && incoming().authorId == request.auth.uid;
      allow update: if isSignedIn() && (
        (incoming().diff(existing()).affectedKeys().hasAny(['likes', 'reposts', 'pollData', 'repliesCount', 'isArchived'])) ||
        (request.auth.uid == existing().authorId && incoming().diff(existing()).affectedKeys().hasOnly(['content', 'updatedAt']))
      );
      allow delete: if isAdmin() || (isSignedIn() && existing().authorId == request.auth.uid);
    }

    match /soc_chats/{chatId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
    }

    match /soc_messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    match /notifications/{notifId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // ─── WORKSPACES ──────────────────────────────────────────────────────────
    match /workspaces/{wsId} {
      allow list: if (isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin())) || resource.data.get('publicLinkEnabled', false) == true;
      allow get: if (isSignedIn() && (resource.data.ownerId == request.auth.uid || isMember(wsId) || isAdmin())) || resource.data.get('publicLinkEnabled', false) == true;
      allow create: if isSignedIn() && incoming().ownerId == request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isOwner(wsId) || isAdmin());
      allow update: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isEditor(wsId) || isAdmin()) && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'publicLinkEnabled', 'settings', 'avatar']);

      // ─── MEMBERS ───────────────────────────────────────────────────────────
      match /members/{memberId} {
        allow read: if isSignedIn() && (
          memberId == request.auth.uid || 
          resource.data.userId == request.auth.uid ||
          isMember(wsId) || 
          isAdmin()
        );
        allow create: if isSignedIn() && (
          request.auth.uid == memberId ||
          isOwner(wsId) || 
          isAdmin()
        );
        allow delete: if isSignedIn() && (request.auth.uid == memberId || isOwner(wsId) || isAdmin());
        allow update: if isSignedIn() && ((isOwner(wsId) && incoming().diff(existing()).affectedKeys().hasOnly(['role'])) || (request.auth.uid == memberId && incoming().diff(existing()).affectedKeys().hasOnly(['status']) && incoming().status == "active") || isAdmin());
      }

      // ─── CONTENT ───────────────────────────────────────────────────────────
      match /content/{contentId} {
        allow read: if (isSignedIn() && (
          (resource != null && resource.data.userId == request.auth.uid) ||
          (resource != null && resource.data.get('sharedUids', []) is list && request.auth.uid in resource.data.get('sharedUids', [])) ||
          isMember(wsId) || 
          isAdmin()
        )) || (resource != null && resource.data.get('isPublic', false) == true) || get(/databases/$(database)/documents/workspaces/$(wsId)).data.get('publicLinkEnabled', false) == true;
        allow create: if isSignedIn() && incoming().workspaceId == wsId && (incoming().userId == request.auth.uid || isAdmin() || isEditor(wsId));
        allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isEditor(wsId) || isAdmin());
        allow update: if isSignedIn() && (
          resource.data.userId == request.auth.uid || 
          isEditor(wsId) || 
          isAdmin() ||
          (request.auth.uid in resource.data.get('editorUids', [])) ||
          ((isCommenter(wsId) || resource.data.get('isPublic', false) == true) && incoming().diff(existing()).affectedKeys().hasOnly(['comments']))
        );

        match /history/{historyId} {
          allow read: if (isSignedIn() && (
            (get(/databases/$(database)/documents/workspaces/$(wsId)/content/$(contentId)).data.userId == request.auth.uid) ||
            (request.auth.uid in get(/databases/$(database)/documents/workspaces/$(wsId)/content/$(contentId)).data.get('sharedUids', [])) ||
            isMember(wsId) ||
            isAdmin()
          )) || (get(/databases/$(database)/documents/workspaces/$(wsId)/content/$(contentId)).data.get('isPublic', false) == true) || get(/databases/$(database)/documents/workspaces/$(wsId)).data.get('publicLinkEnabled', false) == true;
          allow create, update, delete: if isSignedIn() && (
            (get(/databases/$(database)/documents/workspaces/$(wsId)/content/$(contentId)).data.userId == request.auth.uid) ||
            isEditor(wsId) ||
            isAdmin() ||
            (request.auth.uid in get(/databases/$(database)/documents/workspaces/$(wsId)/content/$(contentId)).data.get('editorUids', []))
          );
        }
      }

      // ─── DASHBOARD, TODOS & AUXILIARY ────────────────────────────────────
      match /dashboard/{dashboardId} {
        allow read: if isSignedIn() && (isMember(wsId) || isAdmin());
        allow write: if isSignedIn() && (isEditor(wsId) || isAdmin());
      }

      match /todos/{todoId} {
        allow read: if isSignedIn() && (isMember(wsId) || isAdmin());
        allow write: if isSignedIn() && (isMember(wsId) || isAdmin());
      }

      match /connectedAccounts/{accountId} {
        allow read: if isSignedIn() && (isMember(wsId) || isAdmin());
        allow write: if isSignedIn() && (isEditor(wsId) || isAdmin());
      }

      match /inbox/{messageId} {
        allow read: if isSignedIn() && (isMember(wsId) || isAdmin());
        allow write: if isSignedIn() && (isEditor(wsId) || isAdmin());
      }

      match /commentReplies/{commentId} {
        allow read: if isSignedIn() && (isMember(wsId) || isAdmin());
        allow write: if isSignedIn() && (isMember(wsId) || isAdmin());
      }
    }
  }
}